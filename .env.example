# Get this from https://nextrip-public-api.developer.azure-api.net/products
# Subscribe to the product, then copy the subscription key here.
#
# This file is a template and is committed. Never put a real key in it.
#
# Three places are read, in this order:
#
#   1. the environment
#   2. ./.env
#   3. ~/.config/otransit/.env
#
# Prefer the third. Both implementations of this program read it, so one key
# serves both, and neither repository ever holds a copy.
OC_TRANSPO_SUBSCRIPTION_KEY=your_key_here
